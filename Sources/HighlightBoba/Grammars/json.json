{
  "name": "json",
  "fileExtensions": [
    "json"
  ],
  "initial": "value",
  "states": {
    "array": {
      "rules": [
        {
          "match": {
            "literal": "]"
          },
          "scope": "punctuation",
          "pop": true
        },
        {
          "match": {
            "literal": ","
          },
          "scope": "punctuation"
        },
        {
          "include": "values"
        }
      ]
    },
    "key": {
      "scope": "support.type.property-name",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\u"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 4,
                "max": 4
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[\"\\\\/bfnrt]"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "\\"
          },
          "scope": "invalid"
        },
        {
          "match": {
            "literal": "\""
          },
          "pop": true
        }
      ]
    },
    "member": {
      "rules": [
        {
          "match": {
            "literal": ","
          },
          "scope": "punctuation",
          "pop": true
        },
        {
          "match": {
            "literal": "}"
          },
          "scope": "punctuation",
          "pop": 2
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\""
              },
              {
                "followedBy": {
                  "seq": [
                    {
                      "repeat": "[^\"\\\\\\r\\n]"
                    },
                    {
                      "literal": "\""
                    },
                    {
                      "repeat": "[ \\t]"
                    },
                    {
                      "literal": ":"
                    }
                  ]
                }
              }
            ]
          },
          "scope": "support.type.property-name",
          "pop": 1,
          "push": "key"
        },
        {
          "match": {
            "literal": ":"
          },
          "scope": "punctuation"
        },
        {
          "include": "values"
        }
      ]
    },
    "object": {
      "rules": [
        {
          "match": {
            "literal": "}"
          },
          "scope": "punctuation",
          "pop": true
        },
        {
          "match": {
            "literal": "\""
          },
          "scope": "support.type.property-name",
          "push": "key"
        },
        {
          "match": {
            "literal": ":"
          },
          "scope": "punctuation",
          "push": "member"
        },
        {
          "match": {
            "literal": ","
          },
          "scope": "punctuation"
        }
      ]
    },
    "string": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\u"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 4,
                "max": 4
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[\"\\\\/bfnrt]"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "\\"
          },
          "scope": "invalid"
        },
        {
          "match": {
            "literal": "\""
          },
          "pop": true
        }
      ]
    },
    "value": {
      "rules": [
        {
          "include": "values"
        },
        {
          "match": {
            "class": "[}\\],:]"
          },
          "scope": "punctuation"
        }
      ]
    },
    "values": {
      "rules": [
        {
          "match": {
            "literal": "\""
          },
          "scope": "string.quoted",
          "push": "string"
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "literal": "-"
                }
              },
              {
                "repeat": "[0-9]",
                "min": 1
              },
              {
                "class": "[A-Za-z_]"
              },
              {
                "repeat": "[A-Za-z0-9_]"
              }
            ]
          },
          "scope": "invalid",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "literal": "-"
                }
              },
              {
                "repeat": "[0-9]",
                "min": 1
              },
              {
                "opt": {
                  "seq": [
                    {
                      "literal": "."
                    },
                    {
                      "repeat": "[0-9]",
                      "min": 1
                    }
                  ]
                }
              },
              {
                "opt": {
                  "seq": [
                    {
                      "class": "[eE]"
                    },
                    {
                      "opt": {
                        "class": "[+-]"
                      }
                    },
                    {
                      "repeat": "[0-9]",
                      "min": 1
                    }
                  ]
                }
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "words": [
              "true",
              "false",
              "null"
            ]
          },
          "scope": "constant.language"
        },
        {
          "match": {
            "literal": "{"
          },
          "scope": "punctuation",
          "push": "object"
        },
        {
          "match": {
            "literal": "["
          },
          "scope": "punctuation",
          "push": "array"
        }
      ]
    }
  }
}
