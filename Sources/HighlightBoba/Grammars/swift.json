{
  "name": "swift",
  "fileExtensions": [
    "swift"
  ],
  "initial": "code",
  "wordCharacters": "[A-Za-z0-9_$]",
  "states": {
    "code": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "//"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "scope": "comment.line"
        },
        {
          "match": {
            "literal": "/*"
          },
          "scope": "comment.block",
          "push": "blockComment"
        },
        {
          "match": {
            "seq": [
              {
                "repeat": "[#]",
                "min": 1
              },
              {
                "literal": "\"\"\""
              }
            ]
          },
          "scope": "string.quoted",
          "push": "rawMultilineString",
          "remember": 0
        },
        {
          "match": {
            "seq": [
              {
                "repeat": "[#]",
                "min": 1
              },
              {
                "literal": "\""
              }
            ]
          },
          "scope": "string.quoted",
          "push": "rawString",
          "remember": 0
        },
        {
          "match": {
            "seq": [
              {
                "repeat": "[#]",
                "min": 1
              },
              {
                "literal": "/"
              },
              {
                "eol": true
              }
            ]
          },
          "scope": "string.regexp",
          "push": "extendedRegexLines",
          "remember": 0
        },
        {
          "match": {
            "seq": [
              {
                "repeat": "[#]",
                "min": 1
              },
              {
                "literal": "/"
              }
            ]
          },
          "scope": "string.regexp",
          "push": "extendedRegex",
          "remember": 0
        },
        {
          "match": {
            "seq": [
              {
                "words": [
                  "return",
                  "case",
                  "in",
                  "try",
                  "await",
                  "throw"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "literal": "/"
              },
              {
                "notFollowedBy": {
                  "class": "[ \\t/*]"
                }
              }
            ]
          },
          "captures": [
            "keyword",
            null,
            "string.regexp",
            null
          ],
          "push": "regex"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "/"
              },
              {
                "notFollowedBy": {
                  "class": "[ \\t/*]"
                }
              }
            ]
          },
          "scope": "string.regexp",
          "push": "regex",
          "notAfter": "[A-Za-z0-9_$)\\]\"'`}]"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "`"
              },
              {
                "wordStarting": "[A-Za-z_]"
              },
              {
                "literal": "`"
              }
            ]
          }
        },
        {
          "match": {
            "literal": "\"\"\""
          },
          "scope": "string.quoted",
          "push": "multilineString"
        },
        {
          "match": {
            "literal": "\""
          },
          "scope": "string.quoted",
          "push": "string"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "@"
              },
              {
                "class": "[A-Za-z_]"
              },
              {
                "repeat": "[A-Za-z0-9_]"
              }
            ]
          },
          "scope": "entity.other.attribute"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "#"
              },
              {
                "class": "[A-Za-z_]"
              },
              {
                "repeat": "[A-Za-z0-9_]"
              }
            ]
          },
          "scope": "meta.preprocessor",
          "notAfterWord": true
        },
        {
          "match": {
            "anyOf": [
              {
                "seq": [
                  {
                    "literal": "0"
                  },
                  {
                    "class": "[xX]"
                  },
                  {
                    "repeat": "[0-9A-Fa-f_]"
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "literal": "."
                        },
                        {
                          "class": "[0-9A-Fa-f]"
                        },
                        {
                          "repeat": "[0-9A-Fa-f_]"
                        }
                      ]
                    }
                  },
                  {
                    "seq": [
                      {
                        "class": "[pP]"
                      },
                      {
                        "opt": {
                          "class": "[+-]"
                        }
                      },
                      {
                        "repeat": "[0-9_]",
                        "min": 1
                      }
                    ]
                  }
                ]
              },
              {
                "seq": [
                  {
                    "literal": "0"
                  },
                  {
                    "class": "[xX]"
                  },
                  {
                    "class": "[0-9A-Fa-f]"
                  },
                  {
                    "repeat": "[0-9A-Fa-f_]"
                  }
                ]
              },
              {
                "seq": [
                  {
                    "literal": "0"
                  },
                  {
                    "class": "[bB]"
                  },
                  {
                    "class": "[01]"
                  },
                  {
                    "repeat": "[01_]"
                  }
                ]
              },
              {
                "seq": [
                  {
                    "literal": "0"
                  },
                  {
                    "class": "[oO]"
                  },
                  {
                    "class": "[0-7]"
                  },
                  {
                    "repeat": "[0-7_]"
                  }
                ]
              },
              {
                "seq": [
                  {
                    "class": "[0-9]"
                  },
                  {
                    "repeat": "[0-9_]"
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "literal": "."
                        },
                        {
                          "class": "[0-9]"
                        },
                        {
                          "repeat": "[0-9_]"
                        }
                      ]
                    }
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "class": "[eE]"
                        },
                        {
                          "opt": {
                            "class": "[+-]"
                          }
                        },
                        {
                          "repeat": "[0-9_]",
                          "min": 1
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "words": [
              "true",
              "false",
              "nil"
            ]
          },
          "scope": "constant.language"
        },
        {
          "match": {
            "words": [
              "self",
              "Self",
              "super"
            ]
          },
          "scope": "variable.language"
        },
        {
          "match": {
            "seq": [
              {
                "words": [
                  "func"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "wordStarting": "[A-Za-z_]"
              }
            ]
          },
          "captures": [
            "keyword",
            null,
            "entity.name.function"
          ]
        },
        {
          "match": {
            "words": [
              "associatedtype",
              "class",
              "deinit",
              "enum",
              "extension",
              "fileprivate",
              "func",
              "import",
              "init",
              "inout",
              "internal",
              "let",
              "open",
              "operator",
              "private",
              "precedencegroup",
              "protocol",
              "public",
              "rethrows",
              "static",
              "struct",
              "subscript",
              "typealias",
              "var",
              "break",
              "case",
              "catch",
              "continue",
              "default",
              "defer",
              "do",
              "else",
              "fallthrough",
              "for",
              "guard",
              "if",
              "in",
              "repeat",
              "return",
              "throw",
              "switch",
              "where",
              "while",
              "as",
              "is",
              "try",
              "await",
              "async",
              "throws",
              "some",
              "any",
              "final",
              "override",
              "mutating",
              "nonmutating",
              "lazy",
              "weak",
              "unowned",
              "convenience",
              "required",
              "dynamic",
              "indirect",
              "get",
              "set",
              "willSet",
              "didSet",
              "actor",
              "nonisolated",
              "isolated",
              "consume",
              "borrowing",
              "consuming",
              "package",
              "macro",
              "infix",
              "prefix",
              "postfix"
            ]
          },
          "scope": "keyword",
          "notAfter": "[.]"
        },
        {
          "match": {
            "wordStarting": "[A-Z]"
          },
          "scope": "entity.name.type"
        }
      ]
    },
    "blockComment": {
      "scope": "comment.block",
      "rules": [
        {
          "match": {
            "literal": "/*"
          },
          "push": "blockComment"
        },
        {
          "match": {
            "literal": "*/"
          },
          "pop": true
        }
      ]
    },
    "string": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "include": "stringEscapes"
        },
        {
          "match": {
            "literal": "\""
          },
          "pop": true
        }
      ]
    },
    "multilineString": {
      "scope": "string.quoted",
      "rules": [
        {
          "include": "stringEscapes"
        },
        {
          "match": {
            "literal": "\"\"\""
          },
          "pop": true
        }
      ]
    },
    "stringEscapes": {
      "rules": [
        {
          "match": {
            "literal": "\\("
          },
          "scope": "punctuation.section.embedded",
          "push": "interpolation"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\u{"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 1,
                "max": 8
              },
              {
                "literal": "}"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[0\\\\tnr\"']"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "\\"
          },
          "scope": "invalid"
        }
      ]
    },
    "interpolation": {
      "rules": [
        {
          "match": {
            "literal": ")"
          },
          "scope": "punctuation.section.embedded",
          "pop": true
        },
        {
          "match": {
            "literal": "("
          },
          "push": "parens"
        },
        {
          "include": "code"
        }
      ]
    },
    "parens": {
      "rules": [
        {
          "match": {
            "literal": ")"
          },
          "pop": true
        },
        {
          "match": {
            "literal": "("
          },
          "push": "parens"
        },
        {
          "include": "code"
        }
      ]
    },
    "rawEscapes": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "remembered": true
              },
              {
                "literal": "("
              }
            ]
          },
          "scope": "punctuation.section.embedded",
          "push": "interpolation"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "remembered": true
              },
              {
                "literal": "u{"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 1,
                "max": 8
              },
              {
                "literal": "}"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "remembered": true
              },
              {
                "class": "[0\\\\tnr\"']"
              }
            ]
          },
          "scope": "constant.character.escape"
        }
      ]
    },
    "rawString": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "include": "rawEscapes"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\""
              },
              {
                "remembered": true
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "rawMultilineString": {
      "scope": "string.quoted",
      "rules": [
        {
          "include": "rawEscapes"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\"\"\""
              },
              {
                "remembered": true
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "regex": {
      "scope": "string.regexp",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "match": {
            "literal": "["
          },
          "push": "regexClass"
        },
        {
          "match": {
            "literal": "/"
          },
          "pop": true
        }
      ]
    },
    "regexClass": {
      "scope": "string.regexp",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "match": {
            "literal": "["
          },
          "push": "regexClass"
        },
        {
          "match": {
            "literal": "]"
          },
          "pop": true
        }
      ]
    },
    "extendedRegex": {
      "scope": "string.regexp",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "match": {
            "seq": [
              {
                "literal": "/"
              },
              {
                "remembered": true
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "extendedRegexLines": {
      "scope": "string.regexp",
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "match": {
            "seq": [
              {
                "literal": "/"
              },
              {
                "remembered": true
              }
            ]
          },
          "pop": true
        }
      ]
    }
  }
}
