{
  "name": "python",
  "fileExtensions": [
    "py",
    "pyi"
  ],
  "initial": "code",
  "states": {
    "code": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "#"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "scope": "comment.line"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "@"
              },
              {
                "class": "[A-Za-z_]"
              },
              {
                "repeat": "[A-Za-z0-9_.]"
              }
            ]
          },
          "scope": "entity.other.attribute",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "anyOf": [
                  {
                    "seq": [
                      {
                        "class": "[fF]"
                      },
                      {
                        "class": "[rR]"
                      }
                    ]
                  },
                  {
                    "seq": [
                      {
                        "class": "[rR]"
                      },
                      {
                        "class": "[fF]"
                      }
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "literal": "\"\"\""
                  },
                  {
                    "literal": "'''"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "fRawTriple",
          "notAfterWord": true,
          "remember": 1
        },
        {
          "match": {
            "seq": [
              {
                "anyOf": [
                  {
                    "seq": [
                      {
                        "class": "[fF]"
                      },
                      {
                        "class": "[rR]"
                      }
                    ]
                  },
                  {
                    "seq": [
                      {
                        "class": "[rR]"
                      },
                      {
                        "class": "[fF]"
                      }
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "literal": "\""
                  },
                  {
                    "literal": "'"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "fRawSingle",
          "notAfterWord": true,
          "remember": 1
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[rRbB]"
                }
              },
              {
                "class": "[fF]"
              },
              {
                "opt": {
                  "class": "[rR]"
                }
              },
              {
                "anyOf": [
                  {
                    "literal": "\"\"\""
                  },
                  {
                    "literal": "'''"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "fTriple",
          "notAfterWord": true,
          "remember": 3
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[rRbB]"
                }
              },
              {
                "class": "[fF]"
              },
              {
                "opt": {
                  "class": "[rR]"
                }
              },
              {
                "anyOf": [
                  {
                    "literal": "\""
                  },
                  {
                    "literal": "'"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "fSingle",
          "notAfterWord": true,
          "remember": 3
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[bBuU]"
                }
              },
              {
                "class": "[rR]"
              },
              {
                "opt": {
                  "class": "[bB]"
                }
              },
              {
                "anyOf": [
                  {
                    "literal": "\"\"\""
                  },
                  {
                    "literal": "'''"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "rawTriple",
          "notAfterWord": true,
          "remember": 3
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[bBuU]"
                }
              },
              {
                "class": "[rR]"
              },
              {
                "opt": {
                  "class": "[bB]"
                }
              },
              {
                "anyOf": [
                  {
                    "literal": "\""
                  },
                  {
                    "literal": "'"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "rawSingle",
          "notAfterWord": true,
          "remember": 3
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[bBuU]"
                }
              },
              {
                "anyOf": [
                  {
                    "literal": "\"\"\""
                  },
                  {
                    "literal": "'''"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "plainTriple",
          "notAfterWord": true,
          "remember": 1
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[bBuU]"
                }
              },
              {
                "anyOf": [
                  {
                    "literal": "\""
                  },
                  {
                    "literal": "'"
                  }
                ]
              }
            ]
          },
          "scope": "string.quoted",
          "push": "plainSingle",
          "notAfterWord": true,
          "remember": 1
        },
        {
          "match": {
            "anyOf": [
              {
                "seq": [
                  {
                    "literal": "0"
                  },
                  {
                    "class": "[xXbBoO]"
                  },
                  {
                    "repeat": "[0-9A-Fa-f_]"
                  }
                ]
              },
              {
                "seq": [
                  {
                    "class": "[0-9]"
                  },
                  {
                    "repeat": "[0-9_]"
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "literal": "."
                        },
                        {
                          "repeat": "[0-9_]"
                        }
                      ]
                    }
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "class": "[eE]"
                        },
                        {
                          "opt": {
                            "class": "[+-]"
                          }
                        },
                        {
                          "repeat": "[0-9_]",
                          "min": 1
                        }
                      ]
                    }
                  },
                  {
                    "opt": {
                      "class": "[jJ]"
                    }
                  }
                ]
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "."
              },
              {
                "class": "[0-9]"
              },
              {
                "repeat": "[0-9_]"
              },
              {
                "opt": {
                  "seq": [
                    {
                      "class": "[eE]"
                    },
                    {
                      "opt": {
                        "class": "[+-]"
                      }
                    },
                    {
                      "repeat": "[0-9_]",
                      "min": 1
                    }
                  ]
                }
              },
              {
                "opt": {
                  "class": "[jJ]"
                }
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "words": [
              "True",
              "False",
              "None"
            ]
          },
          "scope": "constant.language"
        },
        {
          "match": {
            "words": [
              "self",
              "cls"
            ]
          },
          "scope": "variable.language"
        },
        {
          "match": {
            "seq": [
              {
                "words": [
                  "def"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "wordStarting": "[A-Za-z_]"
              }
            ]
          },
          "captures": [
            "keyword",
            null,
            "entity.name.function"
          ]
        },
        {
          "match": {
            "seq": [
              {
                "words": [
                  "class"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "wordStarting": "[A-Za-z_]"
              }
            ]
          },
          "captures": [
            "keyword",
            null,
            "entity.name.type"
          ]
        },
        {
          "match": {
            "seq": [
              {
                "bol": true
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "words": [
                  "match",
                  "case"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "notFollowedBy": {
                  "anyOf": [
                    {
                      "class": "[=.,:)\\]<>%/&|^@!;}]"
                    },
                    {
                      "seq": [
                        {
                          "class": "[+*-]"
                        },
                        {
                          "literal": "="
                        }
                      ]
                    },
                    {
                      "words": [
                        "is",
                        "in",
                        "and",
                        "or",
                        "if",
                        "else",
                        "for",
                        "as"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "captures": [
            null,
            null,
            "keyword",
            null,
            null
          ]
        },
        {
          "match": {
            "seq": [
              {
                "bol": true
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "words": [
                  "type"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "followedBy": {
                  "class": "[A-Za-z_]"
                }
              },
              {
                "notFollowedBy": {
                  "words": [
                    "is",
                    "in",
                    "and",
                    "or",
                    "if",
                    "else",
                    "for",
                    "as",
                    "not"
                  ]
                }
              }
            ]
          },
          "captures": [
            null,
            null,
            "keyword",
            null,
            null,
            null
          ]
        },
        {
          "match": {
            "words": [
              "and",
              "as",
              "assert",
              "async",
              "await",
              "break",
              "class",
              "continue",
              "def",
              "del",
              "elif",
              "else",
              "except",
              "finally",
              "for",
              "from",
              "global",
              "if",
              "import",
              "in",
              "is",
              "lambda",
              "nonlocal",
              "not",
              "or",
              "pass",
              "raise",
              "return",
              "try",
              "while",
              "with",
              "yield"
            ]
          },
          "scope": "keyword"
        },
        {
          "match": {
            "words": [
              "print",
              "len",
              "range",
              "int",
              "str",
              "float",
              "list",
              "dict",
              "set",
              "tuple",
              "bool",
              "bytes",
              "open",
              "isinstance",
              "issubclass",
              "super",
              "enumerate",
              "zip",
              "map",
              "filter",
              "sorted",
              "reversed",
              "min",
              "max",
              "sum",
              "abs",
              "any",
              "all",
              "repr",
              "type",
              "object",
              "iter",
              "next",
              "hasattr",
              "getattr",
              "setattr",
              "input",
              "format"
            ]
          },
          "scope": "support.function"
        },
        {
          "match": {
            "wordStarting": "[A-Z]"
          },
          "scope": "entity.name.type"
        }
      ]
    },
    "escapes": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "eol": true
              }
            ]
          },
          "scope": "constant.character.escape",
          "continuesLine": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\x"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 2,
                "max": 2
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\u"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 4,
                "max": 4
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\N{"
              },
              {
                "repeat": "[A-Za-z0-9 -]",
                "min": 1
              },
              {
                "literal": "}"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[\\\\'\"abfnrtv0-7]"
              }
            ]
          },
          "scope": "constant.character.escape"
        }
      ]
    },
    "fSingle": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "include": "escapes"
        },
        {
          "include": "fieldBraces"
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "fTriple": {
      "scope": "string.quoted",
      "rules": [
        {
          "include": "escapes"
        },
        {
          "include": "fieldBraces"
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "field": {
      "spansLines": true,
      "rules": [
        {
          "match": {
            "literal": "}"
          },
          "scope": "punctuation.section.embedded",
          "pop": true
        },
        {
          "match": {
            "class": "[\\[({]"
          },
          "push": "fieldNested"
        },
        {
          "include": "code"
        }
      ]
    },
    "fieldBraces": {
      "rules": [
        {
          "match": {
            "literal": "{{"
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "}}"
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "{"
          },
          "scope": "punctuation.section.embedded",
          "push": "field"
        }
      ]
    },
    "fieldNested": {
      "rules": [
        {
          "match": {
            "class": "[\\])}]"
          },
          "pop": true
        },
        {
          "match": {
            "class": "[\\[({]"
          },
          "push": "fieldNested"
        },
        {
          "include": "code"
        }
      ]
    },
    "plainSingle": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "include": "escapes"
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "plainTriple": {
      "scope": "string.quoted",
      "rules": [
        {
          "include": "escapes"
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "rawSingle": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "eol": true
              }
            ]
          },
          "continuesLine": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "rawTriple": {
      "scope": "string.quoted",
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "fRawSingle": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "eol": true
              }
            ]
          },
          "continuesLine": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "include": "fieldBraces"
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "fRawTriple": {
      "scope": "string.quoted",
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          }
        },
        {
          "include": "fieldBraces"
        },
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    }
  }
}
