{
  "name": "sql",
  "fileExtensions": [
    "sql",
    "psql",
    "pgsql",
    "mysql",
    "sqlite"
  ],
  "initial": "code",
  "states": {
    "backtickIdentifier": {
      "scope": "variable.other",
      "rules": [
        {
          "match": {
            "literal": "``"
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "`"
          },
          "pop": true
        }
      ]
    },
    "bitString": {
      "scope": "constant.numeric",
      "rules": [
        {
          "match": {
            "literal": "'"
          },
          "pop": true
        }
      ]
    },
    "blockComment": {
      "scope": "comment.block",
      "rules": [
        {
          "match": {
            "literal": "/*"
          },
          "push": "blockComment"
        },
        {
          "match": {
            "literal": "*/"
          },
          "pop": true
        }
      ]
    },
    "code": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "--"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "scope": "comment.line"
        },
        {
          "match": {
            "literal": "/*"
          },
          "scope": "comment.block",
          "push": "blockComment"
        },
        {
          "match": {
            "seq": [
              {
                "class": "[eE]"
              },
              {
                "literal": "'"
              }
            ]
          },
          "scope": "string.quoted",
          "push": "escapeString",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "class": "[nN]"
              },
              {
                "literal": "'"
              }
            ]
          },
          "scope": "string.quoted",
          "push": "string",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "class": "[xXbB]"
              },
              {
                "literal": "'"
              }
            ]
          },
          "scope": "constant.numeric",
          "push": "bitString",
          "notAfterWord": true
        },
        {
          "match": {
            "literal": "'"
          },
          "scope": "string.quoted",
          "push": "string"
        },
        {
          "match": {
            "literal": "\""
          },
          "scope": "variable.other",
          "push": "quotedIdentifier"
        },
        {
          "match": {
            "literal": "`"
          },
          "scope": "variable.other",
          "push": "backtickIdentifier"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "$"
              },
              {
                "opt": {
                  "seq": [
                    {
                      "class": "[A-Za-z_]"
                    },
                    {
                      "repeat": "[A-Za-z0-9_]"
                    }
                  ]
                }
              },
              {
                "literal": "$"
              }
            ]
          },
          "scope": "string.quoted",
          "push": "dollarString",
          "remember": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "$"
              },
              {
                "repeat": "[0-9]",
                "min": 1
              }
            ]
          },
          "scope": "variable.parameter"
        },
        {
          "match": {
            "literal": "::"
          },
          "scope": "punctuation"
        },
        {
          "match": {
            "seq": [
              {
                "literal": ":"
              },
              {
                "seq": [
                  {
                    "class": "[A-Za-z_]"
                  },
                  {
                    "repeat": "[A-Za-z0-9_]"
                  }
                ]
              }
            ]
          },
          "scope": "variable.parameter"
        },
        {
          "match": {
            "seq": [
              {
                "repeat": "[@]",
                "min": 1,
                "max": 2
              },
              {
                "seq": [
                  {
                    "class": "[A-Za-z_]"
                  },
                  {
                    "repeat": "[A-Za-z0-9_]"
                  }
                ]
              }
            ]
          },
          "scope": "variable.other"
        },
        {
          "match": {
            "anyOf": [
              {
                "seq": [
                  {
                    "literal": "0"
                  },
                  {
                    "class": "[xX]"
                  },
                  {
                    "repeat": "[0-9A-Fa-f]",
                    "min": 1
                  }
                ]
              },
              {
                "seq": [
                  {
                    "repeat": "[0-9]",
                    "min": 1
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "literal": "."
                        },
                        {
                          "repeat": "[0-9]"
                        }
                      ]
                    }
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "class": "[eE]"
                        },
                        {
                          "opt": {
                            "class": "[+-]"
                          }
                        },
                        {
                          "repeat": "[0-9]",
                          "min": 1
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "seq": [
                  {
                    "literal": "."
                  },
                  {
                    "repeat": "[0-9]",
                    "min": 1
                  },
                  {
                    "opt": {
                      "seq": [
                        {
                          "class": "[eE]"
                        },
                        {
                          "opt": {
                            "class": "[+-]"
                          }
                        },
                        {
                          "repeat": "[0-9]",
                          "min": 1
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "words": [
              "null",
              "NULL",
              "Null",
              "true",
              "TRUE",
              "True",
              "false",
              "FALSE",
              "False",
              "unknown",
              "UNKNOWN",
              "Unknown"
            ]
          },
          "scope": "constant.language"
        },
        {
          "match": {
            "seq": [
              {
                "words": [
                  "function",
                  "FUNCTION",
                  "Function",
                  "procedure",
                  "PROCEDURE",
                  "Procedure"
                ]
              },
              {
                "repeat": "[ \\t]",
                "min": 1
              },
              {
                "wordStarting": "[A-Za-z_]"
              }
            ]
          },
          "captures": [
            "keyword",
            null,
            "entity.name.function"
