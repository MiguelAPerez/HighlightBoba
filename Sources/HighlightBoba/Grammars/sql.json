    "dollarString": {
      "scope": "string.quoted",
      "rules": [
        {
          "match": {
            "remembered": true
          },
          "pop": true
        }
      ]
    },
    "escapeString": {
      "scope": "string.quoted",
      "rules": [
        {
          "match": {
            "literal": "''"
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\x"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 1,
                "max": 2
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\u"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 4,
                "max": 4
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\U"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 8,
                "max": 8
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "repeat": "[0-7]",
                "min": 1,
                "max": 3
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "'"
          },
          "pop": true
        }
      ]
    },
    "quotedIdentifier": {
      "scope": "variable.other",
      "rules": [
        {
          "match": {
            "literal": "\"\""
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "\""
          },
          "pop": true
        }
      ]
    },
    "string": {
      "scope": "string.quoted",
      "rules": [
        {
          "match": {
            "literal": "''"
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "'"
          },
          "pop": true
        }
      ]
    }
