{
  "name": "yaml",
  "fileExtensions": [
    "yaml",
    "yml"
  ],
  "initial": "code",
  "wordCharacters": "[A-Za-z0-9_]",
  "states": {
    "blockScalar": {
      "scope": "string.quoted",
      "endsAtDedent": true,
      "rules": []
    },
    "code": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "bol": true
              },
              {
                "anyOf": [
                  {
                    "literal": "---"
                  },
                  {
                    "literal": "..."
                  }
                ]
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "scope": "punctuation"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "#"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "scope": "comment.line",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "repeat": "[A-Za-z0-9_./-]",
                "min": 1
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "literal": ":"
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "captures": [
            "support.type.property-name",
            null,
            "punctuation",
            null
          ],
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\""
              },
              {
                "repeat": "[^\"\\r\\n]"
              },
              {
                "literal": "\""
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "literal": ":"
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "captures": [
            "support.type.property-name",
            "support.type.property-name",
            "support.type.property-name",
            null,
            "punctuation",
            null
          ]
        },
        {
          "match": {
            "seq": [
              {
                "literal": "'"
              },
              {
                "repeat": "[^'\\r\\n]"
              },
              {
                "literal": "'"
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "literal": ":"
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "captures": [
            "support.type.property-name",
            "support.type.property-name",
            "support.type.property-name",
            null,
            "punctuation",
            null
          ]
        },
        {
          "match": {
            "seq": [
              {
                "literal": "-"
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "scope": "punctuation",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "class": "[|>]"
              },
              {
                "repeat": "[-+0-9]"
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "scope": "punctuation",
          "push": "blockScalar",
          "rememberIndent": true,
          "notAfter": "[^:\\-]"
        },
        {
          "match": {
            "literal": "\""
          },
          "scope": "string.quoted",
          "push": "doubleString",
          "notAfterWord": true
        },
        {
          "match": {
            "literal": "'"
          },
          "scope": "string.quoted",
          "push": "singleString",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "class": "[&*]"
              },
              {
                "repeat": "[A-Za-z0-9_-]",
                "min": 1
              }
            ]
          },
          "scope": "entity.other.attribute",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "!"
              },
              {
                "repeat": "[!A-Za-z0-9_:/.-]"
              }
            ]
          },
          "scope": "keyword",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "words": [
                  "true",
                  "false",
                  "null",
                  "True",
                  "False",
                  "Null",
                  "TRUE",
                  "FALSE",
                  "NULL"
                ]
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t,\\]}]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "scope": "constant.language",
          "notAfter": "[^:\\[{,-]"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "~"
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t,\\]}]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "scope": "constant.language",
          "notAfter": "[^:\\[{,-]"
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[-+]"
                }
              },
              {
                "anyOf": [
                  {
                    "seq": [
                      {
                        "literal": "0x"
                      },
                      {
                        "repeat": "[0-9A-Fa-f_]",
                        "min": 1
                      }
                    ]
                  },
                  {
                    "seq": [
                      {
                        "literal": "0o"
                      },
                      {
                        "repeat": "[0-7_]",
                        "min": 1
                      }
                    ]
                  },
                  {
                    "seq": [
                      {
                        "repeat": "[0-9_]",
                        "min": 1
                      },
                      {
                        "opt": {
                          "seq": [
                            {
                              "literal": "."
                            },
                            {
                              "repeat": "[0-9_]"
                            }
                          ]
                        }
                      },
                      {
                        "opt": {
                          "seq": [
                            {
                              "class": "[eE]"
                            },
                            {
                              "opt": {
                                "class": "[-+]"
                              }
                            },
                            {
                              "repeat": "[0-9]",
                              "min": 1
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t,\\]}]"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfter": "[^:\\[{,-]"
        },
        {
          "match": {
            "class": "[\\[\\]{},]"
          },
          "scope": "punctuation"
        }
      ]
    },
    "doubleString": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "\""
          },
          "pop": true
        }
      ]
    },
    "singleString": {
      "scope": "string.quoted",
      "endsAtEOL": true,
      "rules": [
        {
          "match": {
            "literal": "''"
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "literal": "'"
          },
          "pop": true
        }
      ]
    }
  }
}
