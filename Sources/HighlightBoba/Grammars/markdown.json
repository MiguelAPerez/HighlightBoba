                ]
              },
              {
                "followedBy": {
                  "anyOf": [
                    {
                      "class": "[ \\t>]"
                    },
                    {
                      "literal": "/>"
                    },
                    {
                      "eol": true
                    }
                  ]
                }
              }
            ]
          },
          "push": "htmlBlock"
        },
        {
          "match": {
            "seq": [
              {
                "bol": true
              },
              {
                "repeat": "[ ]",
                "max": 3
              },
              {
                "literal": "["
              },
              {
                "class": "[^\\]^ \\t\\r\\n]"
              },
              {
                "repeat": "[^\\]\\r\\n]"
              },
              {
                "literal": "]:"
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "repeat": "[^ \\t\\r\\n]",
                "min": 1
              },
              {
                "opt": {
                  "seq": [
                    {
                      "repeat": "[ \\t]",
                      "min": 1
                    },
                    {
                      "anyOf": [
                        {
                          "seq": [
                            {
                              "literal": "\""
                            },
                            {
                              "repeat": "[^\"\\r\\n]"
                            },
                            {
                              "literal": "\""
                            }
                          ]
                        },
                        {
                          "seq": [
                            {
                              "literal": "'"
                            },
                            {
                              "repeat": "[^'\\r\\n]"
                            },
                            {
                              "literal": "'"
                            }
                          ]
                        },
                        {
                          "seq": [
                            {
                              "literal": "("
                            },
                            {
                              "repeat": "[^)\\r\\n]"
                            },
                            {
                              "literal": ")"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "eol": true
              }
            ]
          },
          "captures": [
            null,
            null,
            "punctuation",
            null,
            null,
            "punctuation",
            null,
            "markup.link",
            "string.quoted",
            null,
            null
          ]
        },
        {
          "match": {
            "seq": [
              {
                "bol": true
              },
              {
                "repeat": "[ ]",
                "max": 3
              },
              {
                "repeat": "[=]",
                "min": 1
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "eol": true
              }
            ]
          },
          "scope": "markup.heading"
        },
        {
          "include": "inline"
        }
