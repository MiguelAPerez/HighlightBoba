    "htmlBlock": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "bol": true
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "eol": true
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "htmlComment": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "-->"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "htmlRaw": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "</"
              },
              {
                "words": [
                  "PRE",
                  "Pre",
                  "SCRIPT",
                  "STYLE",
                  "Script",
                  "Style",
                  "TEXTAREA",
                  "Textarea",
                  "pre",
                  "script",
                  "style",
                  "textarea"
                ]
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "htmlPI": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "?>"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "htmlCdata": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": "]]>"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "pop": true
        }
      ]
    },
    "htmlDecl": {
      "rules": [
        {
          "match": {
            "seq": [
              {
                "literal": ">"
              },
              {
                "repeat": "[^\\r\\n]"
              }
            ]
          },
          "pop": true
        }
      ]
    }
