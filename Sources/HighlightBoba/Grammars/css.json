                  {
                    "class": "[^\\r\\n0-9A-Fa-f]"
                  }
                ]
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "repeat": "[^)\\s\"'\\\\]",
            "min": 1
          },
          "scope": "string.quoted"
        }
      ]
    },
    "value": {
      "rules": [
        {
          "match": {
            "literal": ";"
          },
          "scope": "punctuation",
          "pop": true
        },
        {
          "match": {
            "followedBy": {
              "class": "[{}]"
            }
          },
          "pop": true
        },
        {
          "match": {
            "literal": "("
          },
          "scope": "punctuation",
          "push": "arguments"
        },
        {
          "include": "valueTokens"
        }
      ]
    },
    "valueTokens": {
      "rules": [
        {
          "include": "trivia"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "!"
              },
              {
                "repeat": "[ \\t]"
              },
              {
                "seq": [
                  {
                    "class": "[iI]"
                  },
                  {
                    "class": "[mM]"
                  },
                  {
                    "class": "[pP]"
                  },
                  {
                    "class": "[oO]"
                  },
                  {
                    "class": "[rR]"
                  },
                  {
                    "class": "[tT]"
                  },
                  {
                    "class": "[aA]"
                  },
                  {
                    "class": "[nN]"
                  },
                  {
                    "class": "[tT]"
                  }
                ]
              },
              {
                "notFollowedBy": {
                  "class": "[A-Za-z0-9_ -퟿-￿-]"
                }
              }
            ]
          },
          "scope": "keyword"
        },
        {
          "match": {
            "seq": [
              {
                "seq": [
                  {
                    "class": "[uU]"
                  },
                  {
                    "class": "[rR]"
                  },
                  {
                    "class": "[lL]"
                  }
                ]
              },
              {
                "literal": "("
              }
            ]
          },
          "captures": [
            "support.function",
            "punctuation"
          ],
          "push": "url"
        },
        {
          "match": {
            "seq": [
              {
                "literal": "--"
              },
              {
                "repeat": "[A-Za-z0-9_ -퟿-￿-]"
              }
            ]
          },
          "scope": "variable.other"
        },
        {
          "match": {
            "seq": [
              {
                "seq": [
                  {
                    "class": "[A-Za-z_ -퟿-￿-]"
                  },
                  {
                    "repeat": "[A-Za-z0-9_ -퟿-￿-]"
                  }
                ]
              },
              {
                "literal": "("
              }
            ]
          },
          "captures": [
            "support.function",
            "punctuation"
          ],
          "push": "arguments"
        },
        {
          "match": {
            "words": [
              "inherit",
              "initial",
              "unset",
              "revert",
              "revert-layer"
            ]
          },
          "scope": "constant.language"
        },
        {
          "match": {
            "seq": [
              {
                "class": "[uU]"
              },
              {
                "literal": "+"
              },
              {
                "repeat": "[0-9A-Fa-f?]",
                "min": 1,
                "max": 6
              },
              {
                "opt": {
                  "seq": [
                    {
                      "literal": "-"
                    },
                    {
                      "repeat": "[0-9A-Fa-f]",
                      "min": 1,
                      "max": 6
                    }
                  ]
                }
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "opt": {
                  "class": "[+-]"
                }
              },
              {
                "anyOf": [
                  {
                    "seq": [
                      {
                        "repeat": "[0-9]",
                        "min": 1
                      },
                      {
                        "opt": {
                          "seq": [
                            {
                              "literal": "."
                            },
                            {
                              "repeat": "[0-9]",
                              "min": 1
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "seq": [
                      {
                        "literal": "."
                      },
                      {
                        "repeat": "[0-9]",
                        "min": 1
                      }
                    ]
                  }
                ]
              },
              {
                "opt": {
                  "seq": [
                    {
                      "class": "[eE]"
                    },
                    {
                      "opt": {
                        "class": "[+-]"
                      }
                    },
                    {
                      "repeat": "[0-9]",
                      "min": 1
                    }
                  ]
                }
              },
              {
                "opt": {
                  "anyOf": [
                    {
                      "literal": "%"
                    },
                    {
                      "seq": [
                        {
                          "class": "[A-Za-z]"
                        },
                        {
                          "repeat": "[A-Za-z]"
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "scope": "constant.numeric",
          "notAfterWord": true
        },
        {
          "match": {
            "seq": [
              {
                "literal": "#"
              },
              {
                "repeat": "[0-9A-Fa-f]",
                "min": 3,
                "max": 8
              },
              {
                "notFollowedBy": {
                  "class": "[A-Za-z0-9_ -퟿-￿-]"
                }
              }
            ]
          },
          "scope": "constant.numeric"
        },
        {
          "match": {
            "seq": [
              {
                "seq": [
                  {
                    "class": "[A-Za-z_ -퟿-￿-]"
                  },
                  {
                    "repeat": "[A-Za-z0-9_ -퟿-￿-]"
                  }
                ]
              }
            ]
          }
        },
        {
          "match": {
            "seq": [
              {
                "literal": "\\"
              },
              {
                "class": "[^\\r\\n]"
              }
            ]
          },
          "scope": "constant.character.escape"
        },
        {
          "match": {
            "class": "[,/]"
          },
          "scope": "punctuation"
        }
      ]
    }
  }
}
