greet() { echo "hi $1"; }
function cleanup { rm -f "$tmp"; } > /dev/null
function wrap() (cd /tmp && ls)
my-tool::run () {
  local dir=$1
}
for name in alpha beta; do echo "$name"; done
for ((i = 0; i < 3; i++)); do echo $i; done
for f in *.sh; { echo "$f"; }
select choice in yes no; do break; done
while read -r line; do :; done < input
until [ -f ready ]; do sleep 1; done
case "$1" in
  start|run) echo go ;;
  (stop) echo halt ;&
  -h|--help) usage ;;&
  *) echo "usage: $0" >&2; exit 1 ;;
esac
if [[ -n $x && $y == *.txt || ! -d $z ]]; then :; elif [[ $v =~ ^v([0-9]+)\.x$ ]]; then :; fi
(( count += 2, total = count * 3 ))
{ echo grouped; echo twice; } | wc -l
( cd sub && make ) || exit
coproc worker { cat; }
