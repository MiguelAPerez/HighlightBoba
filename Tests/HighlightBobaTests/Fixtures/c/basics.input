#include <stdio.h>
#include "boba.h"
  #  define MAX(a, b) ((a) > (b) ? (a) : (b))
#define GREETING "hello" \
    " world"
#if defined(DEBUG) && DEBUG > 1 // trailing comment
#pragma once
#endif

/* A point. */
typedef struct point {
    int x, y;
    const char *label;
} point_t;

enum color { RED, GREEN = 2 };
union value { long l; double d; };

static inline unsigned long long area(const struct point *p) {
    size_t n = sizeof(*p);
    if (p == NULL) return 0ULL;
    for (int i = 0; i < 10; i++) { n += i; }
    return (unsigned long long)p->x * p->y + 0x1Fu + 017 + 0b1010 + 1'000'000 + 1.5e-3f + .25 + 0x1.8p3;
}

int main(void) {
    bool ok = true;
    char c = 'a', nl = '\n', q = '\'', multi = 'ab';
    _Static_assert(sizeof(int) >= 2, "int too small");
    printf("%s %d\n", GREETING, MAX(1, 2));
    goto done;
done:
    return ok ? 0 : 1;
}
