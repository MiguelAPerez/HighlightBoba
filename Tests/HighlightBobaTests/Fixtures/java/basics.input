package dev.boba.app;

import java.util.List;
import static java.lang.Math.*;

/**
 * A greeter.
 * @author someone
 */
@SuppressWarnings("unchecked")
public final class Greeter<T extends Comparable<T>> implements Runnable {
    private static final int MAX_COUNT = 10;
    private final List<String> names;
    private volatile boolean done = false;

    @Override
    public void run() {
        for (int i = 0; i < MAX_COUNT; i++) {
            if (this.names == null || i >= names.size()) break;
            System.out.println("Hello, " + names.get(i) + '!');
        }
        var total = 1_000_000L + 0x1F + 0b1010 + 017 + 3.14f + 2.5e-3d + .5 + 0x1.8p3;
        Object o = super.toString();
        if (o instanceof String s && !s.isEmpty()) { yield(s); }
    }

    sealed interface Shape permits Circle, Square {}
    record Circle(double radius) implements Shape {}
    non-sealed class Square implements Shape {}
    enum Color { RED, GREEN }
    @interface Marker {}

    int classify(Object o) {
        return switch (o) {
            case Integer n when n > 0 -> 1;
            default -> 0;
        };
    }
}
