-- Monthly totals per customer
SELECT c.id, c."Display Name", COUNT(*) AS orders, SUM(o.total)::numeric(10, 2)
FROM customers AS c
LEFT JOIN orders o ON o.customer_id = c.id AND o.status <> 'void'
WHERE c.created_at >= DATE '2024-01-01' AND c.email ILIKE '%@example.com'
GROUP BY c.id
HAVING count(*) > 3
ORDER BY orders DESC NULLS LAST
LIMIT 10 OFFSET 20;

insert into tags (name, weight) values ('boba', 1.5e3), ('tea', .25), (null, 0x1F)
on conflict (name) do nothing returning id;

CREATE TABLE IF NOT EXISTS items (
    id BIGSERIAL PRIMARY KEY,
    label VARCHAR(80) NOT NULL DEFAULT '',
    price DECIMAL(8, 2) CHECK (price >= 0),
    flags BIT(4) DEFAULT B'0101',
    seen TIMESTAMP WITH TIME ZONE DEFAULT now()
);

Update `legacy table` Set `count` = `count` + 1 Where id = ? Or id = :id Or id = $1 Or id = @id;
