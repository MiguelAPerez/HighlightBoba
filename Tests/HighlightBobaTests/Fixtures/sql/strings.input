CREATE OR REPLACE FUNCTION add_one(n integer) RETURNS integer AS $$
    SELECT n + 1; -- 'not a string end'
$$ LANGUAGE sql;
CREATE FUNCTION tagged() RETURNS text AS $body$ SELECT $$ inside $$; $body$ LANGUAGE sql;
