import Foundation
@testable import struct Kit.Thing

public struct Stack<Element: Equatable, each T>: Collection, Sendable where Element: Hashable {
    private(set) var storage: [Element] = []
    static let empty = Stack()
    var count: Int { storage.count }
    var top: Element? {
        get { storage.last }
        set(newTop) { if let newTop { storage.append(newTop) } }
    }
    var observed = 0 {
        willSet { print(newValue) }
        didSet(old) { log(old, to: observed) }
    }
    lazy var get = 1, set: Int = 2
    init?(from items: [Element], _ extra: Int = 0) throws(StackError) where Element: Codable {
        self.storage = items
    }
    convenience init() { self.init(from: [])! }
    deinit {}
    subscript(index i: Int) -> Element { storage[i] }
    mutating func push(_ element: __owned Element, into other: inout [Element]) async rethrows -> Self {
        other.append(element)
        return self
    }
    static func == (lhs: Self, rhs: Self) -> Bool { lhs.storage == rhs.storage }
    func map<U>(_ transform: @escaping (Element) throws -> U) rethrows -> [U] { try storage.map(transform) }
}

enum Token: Equatable {
    case word(String, at: Int), number(Double = 0)
    indirect case pair(Token, Token)
    case Red
}

protocol Shape: AnyObject {
    associatedtype Unit: Numeric = Double
    var area: Unit { get async throws }
    func scaled(by factor: Unit) -> some Shape
}

extension Array where Element == Int {
    func sum() -> Element { reduce(0, +) }
}

actor Counter { var value = 0 }
typealias Handler<T> = (Result<T, any Error>) -> Void
macro stringify<T>(_ value: T) -> (T, String) = #externalMacro(module: "Macros", type: "StringifyMacro")
@available(*, deprecated, renamed: "newName", message: "use it")
func oldName(async: Bool, some: Int, for item: String) {}
let some = 1, any = 2, actor = 3
let open = some + any
